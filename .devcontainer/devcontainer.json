  "name": "EgonarMarket",
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": {
      "label": "EgonarMarket API + boutique",
      "protocol": "http",
      "onAutoForward": "openBrowser",
      "visibility": "private"

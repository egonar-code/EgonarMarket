    "8080": {
      "label": "EgonarMarket aperçu",
      "protocol": "http",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postStartCommand": "bash scripts/codespace-bootstrap.sh",
  "postAttachCommand": "bash scripts/codespace-bootstrap.sh"
}

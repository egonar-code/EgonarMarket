{
  "name": "EgonarMarket",
  "forwardPorts": [3000, 3001, 8080],
  "portsAttributes": {
    "3000": {
      "label": "EgonarMarket API + boutique",
      "protocol": "http",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "3001": {
      "label": "EgonarMarket fournisseurs",
      "protocol": "http",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "8080": {
      "label": "EgonarMarket aperçu",
      "protocol": "http",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postStartCommand": "bash scripts/codespace-start.sh",
  "postAttachCommand": "bash scripts/codespace-start.sh"
}

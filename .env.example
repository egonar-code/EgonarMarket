NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://egonar:change_me@localhost:5432/egonarmarket
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@egonarmarket.sn
ADMIN_PASSWORD=replace-this-password
WHATSAPP_NUMBER=
DELIVERY_DAKAR_FCFA=0
DELIVERY_OTHER_FCFA=0
FRONTEND_URL=http://localhost:3000

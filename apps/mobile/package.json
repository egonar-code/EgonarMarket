{
  "name": "egonarmarket-mobile",
  "private": true,
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "supplier": "EXPO_PUBLIC_APP_ROLE=supplier expo start",
    "admin": "EXPO_PUBLIC_APP_ROLE=admin expo start",
    "android:supplier": "EXPO_PUBLIC_APP_ROLE=supplier expo run:android",
    "android:admin": "EXPO_PUBLIC_APP_ROLE=admin expo run:android",
    "ios:supplier": "EXPO_PUBLIC_APP_ROLE=supplier expo run:ios",
    "ios:admin": "EXPO_PUBLIC_APP_ROLE=admin expo run:ios",
    "web:supplier": "EXPO_PUBLIC_APP_ROLE=supplier expo start --web",
    "web:admin": "EXPO_PUBLIC_APP_ROLE=admin expo start --web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "expo": "^53.0.0",
    "expo-secure-store": "^14.2.0",
    "react": "^19.0.0",
    "react-native": "^0.79.0"
  }
}
